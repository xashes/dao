#lang racket

;; wuxing-data.rkt
;;
;; 功能：
;;   - 提供五行及其相关元素的关系原始数据表。
;;   - 只定义数据，不依赖 graph 库。
;;
;; 数据格式：
;;   (五行 节点 relation source-list)
;;
;;   - 五行        : '木 '火 '土 '金 '水
;;   - 节点        : 方位、季节、干支、数字(整数)、卦象、颜色等
;;   - relation    : #f 或 '生/'克/'旺/'死/'河图/'先天/'后天
;;   - source-list : (listof symbol)，如 '(淮南子 三合 月令)
;; 说明：
;;   - 方向一律约定为“从五行指向其他元素”：
;;       (木 火 生 ...)  : 木生火
;;       (木 东 #f ...)  : 木 <-> 东（静态对应，无 relation）
;;       (木 亥 生 (淮南子 三合 月令)) :
;;           “在亥月时，木之气处于‘生’”，
;;           relation = '生，source 同时标记三合 & 月令。
;;   - relation 为 #f 时，表示“静态对应”，由节点类型和上下文决定语义。
;;   - source 是 symbol 列表，至少一个元素。

(define wuxing-relations
  '(
    ;; ========================================================
    ;; 0. 五行内部：生 / 克（标准五行生克）
    ;; ========================================================
    ;; 生：木生火、火生土、土生金、金生水、水生木
    (木 火 生 (淮南子))
    (火 土 生 (淮南子))
    (土 金 生 (淮南子))
    (金 水 生 (淮南子))
    (水 木 生 (淮南子))

    ;; 克：木克土、土克水、水克火、火克金、金克木
    (木 土 克 (淮南子))
    (土 水 克 (淮南子))
    (水 火 克 (淮南子))
    (火 金 克 (淮南子))
    (金 木 克 (淮南子))

    ;; ========================================================
    ;; 1. 方位（淮南子）
    ;; ========================================================
    (木 东      #f (淮南子))
    (火 南      #f (淮南子))
    (土 中央    #f (淮南子))
    (金 西      #f (淮南子))
    (水 北      #f (淮南子))

    ;; ========================================================
    ;; 2. 季节（淮南子）
    ;; ========================================================
    (木 春      #f (淮南子))
    (火 夏      #f (淮南子))
    (土 季夏    #f (淮南子))
    (金 秋      #f (淮南子))
    (水 冬      #f (淮南子))

    ;; ========================================================
    ;; 3. 五辰（淮南子）
    ;; ========================================================
    (木 岁星    #f (淮南子))
    (火 荧惑    #f (淮南子))
    (土 镇星    #f (淮南子))
    (金 太白    #f (淮南子))
    (水 辰星    #f (淮南子))

    ;; ========================================================
    ;; 4. 五音（淮南子）
    ;; ========================================================
    (木 角      #f (淮南子))
    (火 徵      #f (淮南子))
    (土 宫      #f (淮南子))
    (金 商      #f (淮南子))
    (水 羽      #f (淮南子))

    ;; ========================================================
    ;; 5. 天干（淮南子）
    ;; ========================================================
    (木 甲      #f (淮南子))
    (木 乙      #f (淮南子))
    (火 丙      #f (淮南子))
    (火 丁      #f (淮南子))
    (土 戊      #f (淮南子))
    (土 己      #f (淮南子))
    (金 庚      #f (淮南子))
    (金 辛      #f (淮南子))
    (水 壬      #f (淮南子))
    (水 癸      #f (淮南子))

    ;; ========================================================
    ;; 6. 地支（淮南子）
    ;; ========================================================
    (木 寅      #f (淮南子))
    (木 卯      #f (淮南子))
    (火 巳      #f (淮南子))
    (火 午      #f (淮南子))
    (土 辰      #f (淮南子))
    (土 戌      #f (淮南子))
    (土 丑      #f (淮南子))
    (土 未      #f (淮南子))
    (金 申      #f (淮南子))
    (金 酉      #f (淮南子))
    (水 亥      #f (淮南子))
    (水 子      #f (淮南子))

    ;; ========================================================
    ;; 7. 三合局 & 月令：气机生 / 旺 / 死（淮南子 + 三合 + 月令）
    ;; ========================================================
    ;; 木：生亥、旺卯、死未
    (木 亥      生 (淮南子 三合 月令))
    (木 卯      旺 (淮南子 三合 月令))
    (木 未      死 (淮南子 三合 月令))

    ;; 火：生寅、旺午、死戌
    (火 寅      生 (淮南子 三合 月令))
    (火 午      旺 (淮南子 三合 月令))
    (火 戌      死 (淮南子 三合 月令))

    ;; 土：寄旺四季末（辰、戌、丑、未）
    (土 辰      旺 (淮南子 三合 月令))
    (土 戌      旺 (淮南子 三合 月令))
    (土 丑      旺 (淮南子 三合 月令))
    (土 未      旺 (淮南子 三合 月令))

    ;; 金：生巳、旺酉、死丑
    (金 巳      生 (淮南子 三合 月令))
    (金 酉      旺 (淮南子 三合 月令))
    (金 丑      死 (淮南子 三合 月令))

    ;; 水：生申、旺子、死辰
    (水 申      生 (淮南子 三合 月令))
    (水 子      旺 (淮南子 三合 月令))
    (水 辰      死 (淮南子 三合 月令))

    ;; ========================================================
    ;; 8. 数字（河图数）：数字用整数
    ;; ========================================================
    (木 8       河图 (淮南子 河图))
    (火 7       河图 (淮南子 河图))
    (土 5       河图 (淮南子 河图))
    (金 9       河图 (淮南子 河图))
    (水 6       河图 (淮南子 河图))

    ;; ========================================================
    ;; 9. 五帝 / 神明
    ;; ========================================================
    (木 太皞    #f (淮南子))
    (火 炎帝    #f (淮南子))
    (土 黄帝    #f (淮南子))
    (金 少皞    #f (淮南子))
    (水 颛顼    #f (淮南子))

    (木 太皞    #f (月令))
    (火 炎帝    #f (月令))
    (土 黄帝    #f (月令))
    (金 少皞    #f (月令))
    (水 颛顼    #f (月令))

    ;; ========================================================
    ;; 10. 德性 / 五常（董仲舒）
    ;; ========================================================
    ;; 德性行
    (木 仁      #f (董仲舒 德性))
    (火 智      #f (董仲舒 德性))
    (土 信      #f (董仲舒 德性))
    (金 义      #f (董仲舒 德性))
    (水 礼      #f (董仲舒 德性))

    ;; 五常行
    (木 仁      #f (董仲舒 五常))
    (火 礼      #f (董仲舒 五常))
    (土 信      #f (董仲舒 五常))
    (金 义      #f (董仲舒 五常))
    (水 智      #f (董仲舒 五常))

    ;; ========================================================
    ;; 11. 颜色（淮南子）
    ;; ========================================================
    (木 青      #f (淮南子))
    (火 赤      #f (淮南子))
    (土 黄      #f (淮南子))
    (金 白      #f (淮南子))
    (水 黑      #f (淮南子))

    ;; ========================================================
    ;; 12. 味道（淮南子）
    ;; ========================================================
    (木 酸      #f (淮南子))
    (火 苦      #f (淮南子))
    (土 甘      #f (淮南子))
    (金 辛      #f (淮南子))
    (水 咸      #f (淮南子))

    ;; ========================================================
    ;; 13. 五脏（内经）
    ;; ========================================================
    (木 肝      #f (内经))
    (火 心      #f (内经))
    (土 脾      #f (内经))
    (金 肺      #f (内经))
    (水 肾      #f (内经))

    ;; ========================================================
    ;; 14. 五声（传统）
    ;; ========================================================
    (木 呼      #f (传统))
    (火 笑      #f (传统))
    (土 歌      #f (传统))
    (金 哭      #f (传统))
    (水 呻      #f (传统))

    ;; ========================================================
    ;; 15. 五谷（淮南子）
    ;; ========================================================
    (木 麦      #f (淮南子))
    (火 菽      #f (淮南子))
    (土 稷      #f (淮南子))
    (金 麻      #f (淮南子))
    (水 黍      #f (淮南子))

    ;; ========================================================
    ;; 16. 家畜（淮南子）
    ;; ========================================================
    (木 羊      #f (淮南子))
    (火 鸡      #f (淮南子))
    (土 牛      #f (淮南子))
    (金 犬      #f (淮南子))
    (水 彘      #f (淮南子))

    ;; ========================================================
    ;; 17. 五兵（淮南子）
    ;; ========================================================
    (木 矛      #f (淮南子))
    (火 戟      #f (淮南子))
    (土 剑      #f (淮南子))
    (金 戈      #f (淮南子))
    (水 铩      #f (淮南子))

    ;; ========================================================
    ;; 18. 政令象征（淮南子·时则训）
    ;; ========================================================
    (木 庆赏施惠 #f (淮南子 时则))
    (火 举贤封赏 #f (淮南子 时则))
    (土 平和公正 #f (淮南子 时则))
    (金 诛罚禁暴 #f (淮南子 时则))
    (水 修禁固藏 #f (淮南子 时则))

    ;; ========================================================
    ;; 19. 八卦（淮南子）
    ;; ========================================================
    (木 震      #f (淮南子))
    (火 离      #f (淮南子))
    (土 坤      #f (淮南子))
    (土 艮      #f (淮南子))
    (金 兑      #f (淮南子))
    (水 坎      #f (淮南子))
  ))

(provide wuxing-relations)
